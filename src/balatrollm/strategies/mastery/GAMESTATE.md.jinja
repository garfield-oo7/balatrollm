{#- Live game state for the "mastery" strategy. Facts are computed by
    balatrollm.analysis (Jinja globals) so the model never does arithmetic. -#}
{%- set S = run_status(G, rounds, history) -%}
{%- set plan = main_hand_plan(G) -%}
{%- set boss = boss_impact(G, plan) -%}
{%- set I = shop_impact(G) if G.state in ["SHOP", "SMODS_BOOSTER_OPENED"] else none -%}
{%- macro card_line(c) -%}
{%- if c.state and c.state.hidden -%}face-down card
{%- else -%}{{ c | card_name }} ({{ c | card_chips }} chips)
{%- if c.modifier and c.modifier.enhancement %} {{ c.modifier.enhancement }}{% endif %}
{%- if c.modifier and c.modifier.edition %} {{ c.modifier.edition }}{% endif %}
{%- if c.modifier and c.modifier.seal %} {{ c.modifier.seal }}-seal{% endif %}
{%- if c.state and c.state.debuff %} DEBUFFED (scores 0){% endif %}
{%- endif -%}
{%- endmacro -%}
{%- macro joker_line(j) -%}
{%- if j.state and j.state.hidden -%}face-down joker
{%- else -%}{{ j.label }} {{ joker_tag(j, S.main_hand, S.ante) }}{% if j.modifier and j.modifier.edition %} ({{ j.modifier.edition }}){% endif %}
{%- if j.value and j.value.effect %} | effect: {{ j.value.effect }}{% endif %}
{%- if j.state and j.state.debuff %} | DEBUFFED{% endif %}
{%- endif -%}
{%- endmacro -%}
# STATUS
- Ante {{ S.ante }}/8, round {{ G.round_num }}, money ${{ S.money }}
- MAIN_HAND: {{ S.main_hand }}{% if S.main_suit %} (MAIN_SUIT: {{ S.main_suit }}){% endif %} - {{ S.main_reason }}
- Jokers {{ S.jokers }}/{{ S.joker_limit }}, SLOTS_FREE {{ S.slots_free }}, XMULT_OWNED {{ S.xmult_owned }}
- FLOOR ${{ S.effective_floor }}, SPENDABLE ${{ S.spendable }} (interest next round ${{ S.interest }}){% if G.state == "SHOP" and S.score_spendable > S.spendable %} | SCORE_SPENDABLE ${{ S.score_spendable }} (keeps RESERVE ${{ S.reserve }}) for a score buy: a joker filling an empty slot in Antes 1-3, a joker with SCORE +50% or more, an on-plan [XMULT] joker (not [OFF-PLAN]), a [MAIN] Planet, a Buffoon pack with SLOTS_FREE > 0{% if S.status == "TOO WEAK" %}, or any joker with SCORE above +0 (TOO WEAK){% endif %}{% endif %}
- ECON_OK {{ "YES" if S.econ_ok else "NO" }} (economy jokers owned {{ S.econ_owned }}) | BLUE_SEALS {{ S.blue_seals }}{% if not S.blue_seals %} (none yet: Standard packs and Blue Seal cards are wanted){% endif %}{% if S.hologram %} | HOLOGRAM owned (every card added helps){% endif %}
- INTEREST_SPARE ${{ S.interest_spare }} (spend up to this and next round's interest stays ${{ S.interest }})
- STATUS: {{ S.status }}{% if S.hands_needed %} (next blind {{ S.next_target | fmt_num }} needs about {{ S.hands_needed }} hands: TYPICAL {{ S.main_hand }} scores {{ S.typical | fmt_num }}, made in {{ (S.make_rate * 100) | round | int }}% of hands{% if S.boss_hands and S.boss_target != S.next_target %}; boss {{ S.boss_name }} {{ S.boss_target | fmt_num }} needs about {{ S.boss_hands }} of {{ S.boss_hands_allowed }} hands{% if S.boss_make_rate != S.make_rate %} ({{ S.main_hand }} made in only {{ (S.boss_make_rate * 100) | round | int }}% of hands there){% endif %}{% endif %}){% endif %}{% if S.status == "TOO WEAK" %} -> buy score now{% if S.score_spendable > S.spendable %}: score buys may use SCORE_SPENDABLE ${{ S.score_spendable }}{% endif %}; at most 3 rerolls{% if S.reserve %}, never below RESERVE ${{ S.reserve }}{% endif %}{% endif %}
- GOALS for Ante {{ S.ante }}: {% for g in S.goals %}[{{ "x" if g.done else " " }}] {{ g.text }}{% if not loop.last %}; {% endif %}{% endfor %}
- PRIORITY: {{ S.priority }}.
{%- if S.observatory %}
- Observatory owned: HOLD MAIN_HAND planets instead of using them.
{%- endif %}
{%- if boss.name %}
- Boss this ante: {{ boss.name }} ({{ boss.score | fmt_num }}): {{ boss.effect }}{% if boss.counter %}. Counter: {{ boss.counter }}{% endif %}
{%- if boss.impact %}
- Boss impact: {{ boss.impact }}
{%- endif %}
{%- if boss.prep and G.state in ["SHOP", "SMODS_BOOSTER_OPENED"] %}
- Boss prep (plan this shop for it): {{ boss.prep }}
{%- endif %}
{%- endif %}
{% if G.state == "SELECTING_HAND" %}
{%- set A = play_advice(G) -%}
{%- set P = A.progress %}
# ROUND
- Blind: {{ P.name }}, target {{ P.target | fmt_num }}, scored {{ P.scored | fmt_num }}
- NEED {{ P.remaining | fmt_num }} more | HANDS {{ P.hands_left }} | DISCARDS {{ P.discards_left }} | PER_HAND {{ P.per_hand | fmt_num }}
{%- if P.kind == "boss" and boss.counter %}
- Boss rule now: {{ boss.counter }}
{%- endif %}
{%- if A.blue_in_hand %}
- Blue Seal card in hand at {{ A.blue_in_hand }}: never play or discard it. When the blind is beaten it makes the Planet of your last played hand{% if S.consumable_slots_free %}.{% else %}, but your consumable slots are FULL: use or sell a consumable first.{% endif %}
{%- endif %}

## Your hand (index: card)
{% for c in G.hand.cards -%}
- {{ loop.index0 }}: {{ card_line(c) }}
{% endfor %}
## Listed plays (best per hand type, FLOOR score estimates)
{% for p in A.plays -%}
- {{ p.hand }} {{ p.cards }} = {% for i in p.cards %}{{ G.hand.cards[i] | card_name }}{% if not loop.last %}, {% endif %}{% endfor %} -> {{ p.score | fmt_num }}
{%- if p.blocked %} BLOCKED: {{ p.blocked }}
{%- elif p.wins %} WINS
{%- elif p.reaches_pace %} (reaches PER_HAND)
{%- else %} (below PER_HAND){% endif %}
{%- if p.unknown %} (not counted: {{ p.unknown | join(", ") }}){% endif %}
{% else -%}
- none
{% endfor %}
{%- if A.draws %}
## Draws worth chasing (chance to complete with one discard)
{% for d in A.draws -%}
- {{ d.text }}: discard {{ d.discard }} -> {{ d.chance | pct }}{% if d.if_complete %}, if it hits scores {{ d.if_complete | fmt_num }}{% endif %}{% if d.one_shot %} (wins the blind in one hand){% endif %}{% if d.chase %} = CHASE ({{ d.within | pct }} to hit with your discards){% endif %}
{% endfor %}
{%- endif %}
- Suggested discard: {% if A.discard %}{{ A.discard }} = {% for i in A.discard %}{{ G.hand.cards[i] | card_name }}{% if not loop.last %}, {% endif %}{% endfor %}{% else %}none: play instead{% endif %}
{%- if flags and flags.suggest_action %}
- Suggested action: {% if A.action.tool == "use" %}use consumable {{ A.action.consumable }} with cards {{ A.action.cards }}{% else %}{{ A.action.tool }} {{ A.action.cards }}{% endif %} ({{ A.action.why }})
{%- endif %}
- Suits in hand: {% for s, n in A.hand_suits.items() %}{{ s }} {{ n }}{% if not loop.last %}, {% endif %}{% endfor %} | Deck left {{ A.deck_size }}: {% for s, n in A.deck_suits.items() %}{{ s }} {{ n }}{% if not loop.last %}, {% endif %}{% endfor %}
{% endif %}
{%- if G.state == "SHOP" %}
# SHOP
{%- if I and I.score %}
- TYPICAL {{ I.hand }}{% if I.plays > 1 %} (average of the {{ I.plays }} {{ I.hand }} plays your deck can make, e.g. {{ I.cards | join(", ") }}){% else %} ({{ I.cards | join(", ") }}){% endif %} scores about {{ I.score | fmt_num }} per hand now.{% set nb0 = next_blind(G) %}{% if nb0 and nb0.score %} Next blind {{ nb0.score | fmt_num }} = about {{ ((nb0.score + I.score - 1) // I.score) | int }} such hands.{% endif %}
- SCORE = change per hand of that average play if you buy the item ([SCALE] jokers show today's value; they grow).
{%- endif %}
{%- if G.shop and G.shop.cards %}
{%- set sk = namespace(modified=false, death=false, hanged=false) %}
{%- for c in (G.cards.cards if G.cards and G.cards.cards else []) %}{% if c.modifier and (c.modifier.seal or c.modifier.enhancement or c.modifier.edition) %}{% set sk.modified = true %}{% endif %}{% endfor %}
{%- for c in G.shop.cards %}{% if c.label == "Death" %}{% set sk.death = true %}{% elif c.label == "The Hanged Man" %}{% set sk.hanged = true %}{% endif %}{% endfor %}
{%- for card in G.shop.cards -%}
{%- if card.state and card.state.hidden %}
- {{ loop.index0 }}: face-down card
{%- elif card.set == "JOKER" %}
- {{ loop.index0 }}: {{ card.label }} ${{ card.cost.buy }} {{ joker_tag(card, S.main_hand, S.ante) }}{% set gx = grows_xmult(G, card) %}{% if gx %} {{ gx }}{% endif %}{% if card.modifier and card.modifier.edition %} ({{ card.modifier.edition }}){% endif %}{% if I and I.shop[loop.index0] %} | SCORE {{ I.shop[loop.index0] }}{% endif %} | effect: {{ card.value.effect }}
{%- elif card.set in ["TAROT", "PLANET", "SPECTRAL"] %}
- {{ loop.index0 }}: {{ card.label }} ({{ card.set | title }}) ${{ card.cost.buy }} {% if card.label == "Death" and not sk.modified %}[SKIP] no sealed, enhanced or edition card in your deck to copy{% if sk.hanged %}: take The Hanged Man instead{% endif %}{% else %}{{ consumable_tag(card, S.main_hand, S.blue_seals, S.deck_total, S.constellation) }}{% endif %}{% if I and I.shop[loop.index0] %} | SCORE {{ I.shop[loop.index0] }}{% endif %}
{%- else %}
- {{ loop.index0 }}: {{ card_line(card) }} (playing card) ${{ card.cost.buy }}{% if S.hologram %} [OK: Hologram grows with every card added]{% else %} [SKIP]{% endif %}
{%- endif %}
{%- endfor %}
{%- else %}
- no cards left
{%- endif %}
- Reroll cost: ${{ G.round.reroll_cost }}
{%- if G.vouchers and G.vouchers.cards %}

## Vouchers (use buy with `voucher`)
{% for v in G.vouchers.cards -%}
- {{ loop.index0 }}: {{ v.label }} ${{ v.cost.buy }} {% if S.ante == 1 %}[NEVER] no vouchers in Ante 1: money goes to jokers{% else %}{{ voucher_tag(v, S.hologram) }}{% endif %}
{% endfor %}
{%- endif %}
{%- if G.packs and G.packs.cards %}
## Packs (use buy with `pack`)
{% for p in G.packs.cards -%}
- {{ loop.index0 }}: {{ p.label }} ${{ p.cost.buy }}{% if p.value and p.value.effect %} | {{ p.value.effect }}{% endif %}
{% endfor %}
{%- endif %}
{%- set nb = next_blind(G) %}
{%- if nb %}
- Next blind: {{ nb.name or nb.kind }} ({{ nb.score | fmt_num }} chips)
{%- endif %}
{%- endif %}
{%- if G.state == "SMODS_BOOSTER_OPENED" %}
# OPEN PACK (pick 1 card or skip)
{%- set pk = namespace(modified=false, death=false, hanged=false) %}
{%- for c in (G.hand.cards if G.hand and G.hand.cards else []) %}{% if c.modifier and (c.modifier.seal or c.modifier.enhancement or c.modifier.edition) %}{% set pk.modified = true %}{% endif %}{% endfor %}
{%- for c in G.pack.cards %}{% if c.label == "Death" %}{% set pk.death = true %}{% elif c.label == "The Hanged Man" %}{% set pk.hanged = true %}{% endif %}{% endfor %}
{%- set death_skip = pk.death and not pk.modified %}
{% for card in G.pack.cards -%}
{%- if card.set == "JOKER" -%}
{%- set jt = joker_tag(card, S.main_hand, S.ante) -%}
- {{ loop.index0 }}: {{ card.label }} (Joker) {{ jt }}{% set gx = grows_xmult(G, card) %}{% if gx %} {{ gx }}{% endif %}{% if card.modifier and card.modifier.edition %} ({{ card.modifier.edition }}){% endif %}{% if I and I.pack[loop.index0] %} | SCORE {{ I.pack[loop.index0] }}{% endif %} | effect: {{ card.value.effect }} | sells for ${{ card.cost.sell }}{% if S.slots_free and ('tier T' in jt or '[TRAP]' in jt) %} [CASH ONLY: take it if nothing better, then sell it in the shop]{% endif %}
{%- elif card.set in ["TAROT", "PLANET", "SPECTRAL"] -%}
{%- set tg = consumable_targets(card.key) %}
{%- set sug = suggest_targets(G, card) -%}
- {{ loop.index0 }}: {{ card.label }} ({{ card.set | title }}) {% if death_skip and card.label == "Death" %}[SKIP] no sealed, enhanced or edition card in hand to copy{% if pk.hanged %}: take The Hanged Man instead{% endif %}{% elif card.label == "Immolate" and pk.modified %}[AVOID] a sealed or enhanced card is in hand: Immolate may destroy it{% else %}{{ consumable_tag(card, S.main_hand, S.blue_seals, S.deck_total, S.constellation) }}{% endif %}
{%- if tg %} | needs {{ tg[0] }}-{{ tg[1] }} target cards{% if sug %}. Suggested targets: {{ sug }}{% else %}. No good targets: do not pick{% endif %}{% endif %}
{%- else -%}
- {{ loop.index0 }}: {{ card_line(card) }} (playing card){% if card.modifier and card.modifier.seal == "BLUE" %}{% if S.blue_seals and not S.hologram %} [SKIP: you already own a Blue Seal card]{% elif S.blue_seals %} [OK: Hologram grows with every card added]{% else %} [PICK: Blue Seal, you have none]{% endif %}{% endif %}
{%- endif %}
{% endfor %}
{%- if G.hand and G.hand.cards %}
## Cards in hand (for targets)
{% for c in G.hand.cards -%}
- {{ loop.index0 }}: {{ card_line(c) }}
{% endfor %}
{%- endif %}
{%- endif %}

# JOKERS (left to right){% if I and I.weakest and not S.slots_free %}. WEAKEST: {{ I.weakest.index }} {{ I.weakest.label }} (adds {{ I.weakest.gain | fmt_num }} per hand){% endif %}
{% for j in G.jokers.cards -%}
- {{ loop.index0 }}: {{ joker_line(j) }}{% if I and I.owned[loop.index0] %} | {{ I.owned[loop.index0] }}{% endif %} | sells for ${{ j.cost.sell }}{% set jt = joker_tag(j, S.main_hand, S.ante) %}{% if G.state == 'SHOP' and ('tier T' in jt or '[TRAP]' in jt) %} [SELL NOW: it hurts your run]{% endif %}
{% else -%}
- none (empty slots lose runs: buy scoring jokers)
{% endfor %}
# CONSUMABLES ({{ G.consumables.count }}/{{ G.consumables.limit }})
{% for c in G.consumables.cards -%}
{%- set sug = suggest_targets(G, c) if G.state == "SELECTING_HAND" else [] -%}
- {{ loop.index0 }}: {{ c.label }} {{ consumable_tag(c, S.main_hand, S.blue_seals, S.deck_total, S.constellation) }}{% if consumable_targets(c.key) %}{% if sug %} | Suggested targets: {{ sug }}{% elif G.state == "SELECTING_HAND" %} | no good targets now{% else %} | needs cards in hand: use it during a round{% endif %}{% endif %}
{% else -%}
- none
{% endfor %}
# POKER HANDS (level: chips x mult, times played)
{% for h in hands_table(G) -%}
- {{ h.name }}{% if h.name == S.main_hand %} (MAIN_HAND){% endif %}: Lv{{ h.level }} {{ h.chips }} x {{ h.mult }}, played {{ h.played }}
{% endfor %}
{%- if G.state == "SHOP" %}
{%- set D = deck_summary(G) %}
# DECK ({{ D.size }} cards)
- Suits: {% for s, n in D.suits.items() %}{{ s }} {{ n }}{% if not loop.last %}, {% endif %}{% endfor %}
{%- if D.enhancements %} | Enhanced: {% for k, n in D.enhancements.items() %}{{ k }} {{ n }}{% if not loop.last %}, {% endif %}{% endfor %}{% endif %}
{%- endif %}
{%- if G.used_vouchers %}
- Vouchers owned: {{ G.used_vouchers.keys() | join(", ") }}
{%- endif %}
