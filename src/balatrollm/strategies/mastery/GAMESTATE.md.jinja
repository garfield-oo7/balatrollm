{%- elif card.set == "JOKER" %}
- {{ loop.index0 }}: {{ card.label }} ${{ card.cost.buy }} {{ joker_tag(card, S.tag_hand, S.ante) }}{% set gx = grows_xmult(G, card) %}{% if gx %} {{ gx }}{% endif %}{% set cn = clash_note(G, card) %}{% if cn %} {{ cn }}{% endif %}{% if card.modifier and card.modifier.edition %} ({{ card.modifier.edition }}){% endif %}{% if I and I.shop[loop.index0] %} | SCORE {{ I.shop[loop.index0] }}{% endif %}{% if I and I.swaps[loop.index0] %} | {{ I.swaps[loop.index0].text }}{% endif %} | effect: {{ card.value.effect }}
